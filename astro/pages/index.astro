---
import Layout from '@levino/shipyard-base/layouts/Page.astro'
import { klasse } from 'virtual:fws-klasse/config'
import { offeneListen } from '../../src/lib/db/mitbringen.ts'

export const prerender = false

/**
 * Offene Mitbringlisten — nur fuer Angemeldete sichtbar (diese Seite liegt
 * hinter dem Login). Gaeste bekommen den Link direkt vom admin.
 */
const listen = offeneListen()
---

<Layout title="Willkommen">
  <div class="container mx-auto px-4 py-12 max-w-4xl">
    <div class="prose max-w-none mb-12">
      <h1>Willkommen!</h1>
      <p class="text-lg">
        Hier findest Du alle wichtigen Unterlagen und Berichte für die Eltern der {klasse.label}
        an der Freien Waldorfschule Hannover-Maschsee.
      </p>
      <p>
        Fehlt etwas oder stimmt eine Information nicht mehr? Kein Problem!
        Du kannst gerne <a href={klasse.feedbackUrl} target="_blank" rel="noopener">auf GitHub davon berichten</a>
        oder direkt Änderungen vorschlagen.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="card bg-base-100 shadow-xl">
        <div class="card-body">
          <h2 class="card-title">Unterlagen</h2>
          <p>Alle wichtigen Dokumente: Putzplan, Klassenkasse, Ämter, Termine und mehr.</p>
          <div class="card-actions justify-end">
            <a href="/docs" class="btn btn-primary">Zu den Unterlagen</a>
          </div>
        </div>
      </div>

      <div class="card bg-base-100 shadow-xl">
        <div class="card-body">
          <h2 class="card-title">Berichte</h2>
          <p>Protokolle von Elternabenden und andere Neuigkeiten aus der Klasse.</p>
          <div class="card-actions justify-end">
            <a href="/blog" class="btn btn-primary">Zu den Berichten</a>
          </div>
        </div>
      </div>

      {listen.length > 0 && (
        <div class="card bg-base-100 shadow-xl">
          <div class="card-body">
            <h2 class="card-title">Mitbringlisten</h2>
            <ul class="list-disc pl-5">
              {listen.map((l) => (
                <li>
                  <a class="link link-primary" href={`/public/mitbringen/${l.id}`}>{l.title}</a>
                  {l.event_date && <span class="opacity-70"> · {l.event_date}</span>}
                </li>
              ))}
            </ul>
          </div>
        </div>
      )}

      <div class="card bg-base-100 shadow-xl">
        <div class="card-body">
          <h2 class="card-title">Mailverteiler</h2>
          <p>Welche Verteiler es gibt, wen sie erreichen und wer an sie schreiben darf.</p>
          <div class="card-actions justify-end">
            <a href="/verteiler" class="btn btn-primary">Zu den Verteilern</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>
