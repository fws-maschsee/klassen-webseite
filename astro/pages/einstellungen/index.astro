---
import Layout from '@levino/shipyard-base/layouts/Page.astro'
import { klassenConfig } from '../../../src/klasse/config.ts'
import {
	beantrageAdresswechsel,
	GUELTIGKEIT_SEKUNDEN,
	offeneAnforderung,
} from '../../../src/lib/db/emailChange.ts'
import { openDb } from '../../../src/lib/db/index.ts'
import {
	listMailingLists,
	normalizeEmail,
} from '../../../src/lib/db/mailingLists.ts'
import {
	EIGENE_POST,
	einstellungenFuer,
	istEigenePost,
	setzeEinstellung,
	VORGABE,
} from '../../../src/lib/db/recipientSettings.ts'
import { mitgliedFuerKonto, ohneGruppe } from '../../../src/lib/db/users.ts'
import { sendeBestaetigung } from '../../../src/lib/email/adresswechsel.ts'

export const prerender = false

/**
 * Was bekomme ich, und wohin? Drei Fragen auf einer Seite, hinter dem Login.
 *
 *   1. An WELCHE Adresse geht die Post?      (Zustelladresse, mit Bestätigung)
 *   2. Bekomme ich die Post dieses Verteilers? (an / aus)
 *   3. Was passiert mit MEINER eigenen Nachricht, wenn ich an den Verteiler
 *      schreibe?                              (Kopie / Bestätigung / nichts)
 *
 * 2 und 3 sind unabhängig voneinander, und deshalb stehen sie nicht in einer
 * Liste von vier Möglichkeiten: Wer abgemeldet ist, darf weiter an den
 * Verteiler schreiben — und will dann womöglich gerade DESHALB eine
 * Bestätigung, weil er das Ergebnis sonst nirgends zu sehen bekommt.
 *
 * WELCHE ADRESSE HIER GILT — und das hat sich geändert: die ZUSTELLADRESSE aus
 * dem Adressbuch, nicht die Anmeldeadresse. Beim ersten Anmelden wird sie von
 * dort übernommen, danach ist sie frei änderbar (Frage 1). Ständen die
 * Einstellungen weiter an der Anmeldeadresse, wäre jede von ihnen nach der
 * ersten Adressänderung wirkungslos — eingestellt für eine Adresse, die keine
 * Post bekommt.
 *
 * Was sich NICHT geändert hat: Der Bezug sagt, welchen Eintrag dieses Konto
 * verwaltet. Er sagt nicht, wer Post bekommt. Das entscheidet weiterhin die
 * Gruppenzugehörigkeit, und die setzt ein Mensch — wer in keiner Gruppe steht,
 * liest das hier oben als Erstes.
 */

const { label: klasse, contactMail, contactName } = klassenConfig()
const db = openDb()

// `Astro.locals.user` setzt die Anmelde-Middleware; sie hält dort auch den
// Bezug zum Adressbuch fest. Ohne Anmeldung kommt hier niemand an — dieser Pfad
// steht nicht in `PUBLIC_PATHS`.
const sub = Astro.locals.user?.sub ?? ''
const anmeldeAdresse = normalizeEmail(Astro.locals.user?.email ?? '')
let mitglied = sub ? (mitgliedFuerKonto(sub, db) ?? null) : null

const TAGE = Math.round(GUELTIGKEIT_SEKUNDEN / 86400)

let gespeichert = false
let angefordert: string | null = null
let adressFehler: string | null = null

if (Astro.request.method === 'POST') {
	const formular = await Astro.request.formData()
	// Zwei Formulare auf einer Seite. Der WERT ist englisch, die Beschriftung
	// daneben deutsch — dieselbe Trennlinie wie überall sonst.
	const form = formular.get('form')

	if (form === 'address' && mitglied) {
		const gewuenscht = String(formular.get('new_email') ?? '')
		try {
			const anforderung = beantrageAdresswechsel(mitglied.id, gewuenscht, db)
			// ERST die Mail, DANN die Erfolgsmeldung: Wenn der Versand scheitert,
			// hat die Person einen Schlüssel in der Datenbank, von dem sie nie
			// erfährt — und wartet auf eine Mail, die nicht kommt.
			await sendeBestaetigung(anforderung.new_email, anforderung.token, TAGE)
			angefordert = anforderung.new_email
		} catch (fehler) {
			adressFehler =
				fehler instanceof Error ? fehler.message : 'Das hat nicht geklappt.'
		}
	}

	if (form === 'lists' && mitglied?.email) {
		const adresse = normalizeEmail(mitglied.email)
		for (const liste of listMailingLists(db)) {
			const eigene = formular.get(`eigene:${liste.address}`)
			setzeEinstellung(
				liste.address,
				adresse,
				{
					// Eine nicht angekreuzte Box schickt gar nichts mit — Abwesenheit
					// IST hier die Angabe „aus".
					subscribed: formular.get(`abo:${liste.address}`) === 'an',
					ownMail: istEigenePost(eigene) ? eigene : VORGABE.ownMail,
				},
				db,
			)
		}
		gespeichert = true
	}

	// Nach dem Schreiben neu lesen: Die Adresse kann sich (durch eine
	// Bestätigung in einem anderen Browser) inzwischen geändert haben.
	mitglied = sub ? (mitgliedFuerKonto(sub, db) ?? null) : mitglied
}

const zustellAdresse = normalizeEmail(mitglied?.email ?? '')
const offen = mitglied ? offeneAnforderung(mitglied.id, db) : null
const keineGruppe = mitglied ? ohneGruppe(mitglied.id, db) : false

const listen = zustellAdresse
	? einstellungenFuer(zustellAdresse, listMailingLists(db), db)
	: []

/**
 * Die Beschriftungen. Sie sind deutsch, die WERTE daneben englisch — das ist
 * die Trennlinie: `copy` liest das Programm, „Kopie an mich" liest ein Mensch.
 */
const BEZEICHNUNG: Record<(typeof EIGENE_POST)[number], string> = {
	copy: 'Kopie an mich',
	confirmation: 'Bestätigung, sobald sie zugestellt ist',
	none: 'Nichts',
}

const ERKLAERUNG: Record<(typeof EIGENE_POST)[number], string> = {
	copy: 'Die eigene Nachricht kommt wie bei allen anderen zurück.',
	confirmation:
		'Statt der eigenen Nachricht eine kurze Meldung: an wie viele zugestellt, und was gescheitert ist.',
	none: 'Weder die eigene Nachricht noch eine Meldung.',
}
---

<Layout title="Einstellungen">
	<div class="prose max-w-2xl">
		<h1>Verteiler-Einstellungen</h1>

		{
			keineGruppe && (
				<div class="not-prose rounded-lg border border-warning/40 bg-warning/10 p-4 text-sm">
					<p>
						<strong>
							Du stehst in keiner Gruppe — und bekommst deshalb noch keine Post.
						</strong>
					</p>
					<p class="mt-2">
						Ein Zugang zur Seite ist nicht dasselbe wie ein Platz im Verteiler.
						Dein Eintrag im Adressbuch ist angelegt, aber wer Post bekommt,
						trägt ein Mensch ein. Schreib{' '}
						<a href={`mailto:${contactMail}`}>{contactName ?? contactMail}</a>,
						dann wirst du in die passende Gruppe gesetzt. Bis dahin kannst du
						hier alles einstellen — wirken wird es ab dann.
					</p>
				</div>
			)
		}

		{
			!mitglied && (
				<div class="not-prose rounded-lg border border-warning/40 bg-warning/10 p-4 text-sm">
					<p>
						<strong>
							Zu deiner Anmeldung gibt es hier noch keinen Eintrag im Adressbuch.
						</strong>
					</p>
					<p class="mt-2">
						Normalerweise entsteht er beim Anmelden von selbst. Wenn diese
						Meldung bleibt, sag{' '}
						<a href={`mailto:${contactMail}`}>{contactName ?? contactMail}</a>{' '}
						Bescheid.
					</p>
				</div>
			)
		}

		<h2>Wohin die Post geht</h2>

		<p>
			Angemeldet bist du als <strong>{anmeldeAdresse}</strong>. Die Post der{' '}
			{klasse} geht an{' '}
			<strong>{zustellAdresse || 'keine hinterlegte Adresse'}</strong>.
		</p>

		<p class="text-sm opacity-70">
			Die beiden dürfen verschieden sein, und das ist Absicht: Anmeldung und
			Information sind zwei Dinge. Wer sich mit der Arbeitsadresse anmeldet,
			darf die Elternpost trotzdem privat lesen.
		</p>

		{
			angefordert && (
				<p class="text-success">
					<strong>Mail unterwegs.</strong> Wir haben an {angefordert}{' '}
					geschrieben. Erst der Klick auf den Link darin macht die Adresse
					gültig — bis dahin bleibt alles, wie es ist. Der Link gilt {TAGE}{' '}
					Tage.
				</p>
			)
		}

		{
			adressFehler && (
				<p class="text-error">
					<strong>Das hat nicht geklappt:</strong> {adressFehler}
				</p>
			)
		}

		{
			offen && !angefordert && (
				<p class="text-sm">
					Für <strong>{offen.new_email}</strong> steht eine Bestätigung aus.
					Solange niemand den Link in der Mail anklickt, bleibt{' '}
					<strong>{zustellAdresse}</strong> die Zustelladresse.
				</p>
			)
		}

		{
			mitglied && (
				<form method="POST" class="not-prose flex flex-col gap-3 mb-8">
					<input type="hidden" name="form" value="address" />
					<label class="flex flex-col gap-1">
						<span class="text-sm font-semibold">Neue Zustelladresse</span>
						<input
							type="email"
							name="new_email"
							required
							placeholder="post@example.org"
							class="input input-bordered max-w-sm"
						/>
					</label>
					<button type="submit" class="btn btn-primary self-start">
						Bestätigungsmail schicken
					</button>
					<p class="text-sm opacity-70 max-w-prose">
						Die Mail geht an die NEUE Adresse. Das ist der Sinn der Sache: Ohne
						diesen Schritt könnte jemand die Post einer anderen Familie auf
						seine eigene Adresse umleiten, und die Betroffenen merkten es erst
						daran, dass nichts mehr kommt.
					</p>
				</form>
			)
		}

		<h2>Was von welchem Verteiler kommt</h2>

		{
			gespeichert && (
				<p class="text-success">
					<strong>Gespeichert.</strong> Ab der nächsten Nachricht gilt das Neue.
				</p>
			)
		}

		<form method="POST" class="not-prose flex flex-col gap-8">
			<input type="hidden" name="form" value="lists" />
			{
				listen.map((liste) => (
					<section class="border border-base-300 rounded-lg p-4">
						<h3 class="font-semibold text-lg">{liste.label}</h3>
						<p class="text-sm opacity-70 mb-4">{liste.address}</p>

						<label class="flex items-center gap-3 cursor-pointer">
							<input
								type="checkbox"
								name={`abo:${liste.address}`}
								value="an"
								checked={liste.subscribed}
								class="toggle toggle-sm"
							/>
							<span>Post von diesem Verteiler bekommen</span>
						</label>

						{/* Die zweite Frage steht bewusst NICHT unter der ersten als deren
						    Unterpunkt: Sie gilt auch für Abgemeldete, weil die weiter an
						    den Verteiler schreiben dürfen. */}
						<fieldset class="mt-5 border-t border-base-300 pt-4">
							<legend class="text-sm font-semibold px-1">
								Wenn ich selbst an diesen Verteiler schreibe
							</legend>
							<div class="flex flex-col gap-2 mt-2">
								{EIGENE_POST.map((wert) => (
									<label class="flex items-start gap-3 cursor-pointer">
										<input
											type="radio"
											name={`eigene:${liste.address}`}
											value={wert}
											checked={liste.ownMail === wert}
											class="radio radio-sm mt-1"
										/>
										<span>
											<span class="font-medium">{BEZEICHNUNG[wert]}</span>
											<br />
											<span class="text-sm opacity-70">{ERKLAERUNG[wert]}</span>
										</span>
									</label>
								))}
							</div>
						</fieldset>
					</section>
				))
			}

			<button type="submit" class="btn btn-primary self-start">Speichern</button>
		</form>
	</div>
</Layout>
