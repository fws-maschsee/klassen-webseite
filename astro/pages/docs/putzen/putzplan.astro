---
import Layout from '@levino/shipyard-docs/astro/Layout.astro'
import { getEntry, render } from 'astro:content'
import { bearbeitenUrl, klassenConfig } from '../../../../src/klasse/config.ts'
import {
  planAlsEintraege,
  putzplanZeilen,
} from '../../../../src/klasse/putzplan.ts'

export const prerender = false

const eintrag = await getEntry('docs', 'putzen/putzplan')

// 404 statt Umleitung: so darf die Route in jeder Klasse bedingungslos hängen.
if (!eintrag || eintrag.data.render === false) {
  return new Response(null, { status: 404 })
}

const { Content, headings } = await render(eintrag)

// Leer bewusst ohne Hinweis: manche Klasse führt die Tabelle noch im Markdown darüber.
const zeilen = putzplanZeilen(planAlsEintraege())

const UEBERSCHRIFT = 'Einteilung'
const UEBERSCHRIFT_ANKER = 'einteilung'

const inhaltsverzeichnis =
  zeilen.length > 0
    ? [...headings, { depth: 2, text: UEBERSCHRIFT, slug: UEBERSCHRIFT_ANKER }]
    : headings

const klasse = klassenConfig()
const editUrl = bearbeitenUrl(klasse, 'src/content/docs/putzen/putzplan.md')
---

<Layout headings={inhaltsverzeichnis} routeBasePath="docs" editUrl={editUrl}>
  <Content />

  {zeilen.length > 0 && (
    <>
      <h2 id={UEBERSCHRIFT_ANKER}>{UEBERSCHRIFT}</h2>

      <table>
        <thead>
          <tr>
            <th>Familie</th>
            <th>Datum</th>
            <th>Anmerkungen</th>
          </tr>
        </thead>
        <tbody>
          {zeilen.map((zeile) => (
            <tr id={`termin-${zeile.id}`}>
              <td>{zeile.familie}</td>
              <td><time datetime={zeile.iso}>{zeile.datum}</time></td>
              <td>{zeile.anmerkung}</td>
            </tr>
          ))}
        </tbody>
      </table>

      <p>Geputzt wird am Wochenende, frühestens am Freitag.</p>

      <p>
        Denkt an den Schlüssel: Den holt ihr am besten schon am Freitag ab.
        Am Wochenende ist niemand in der Schule, der euch aufschließen kann.
      </p>

      <p>
        <a href="/docs/putzen/putzplan.pdf">Diesen Plan als PDF herunterladen</a>
        — zum Ausdrucken und Aufhängen.
      </p>

      <p>
        Wer an seinem Termin nicht kann, tauscht am besten direkt mit einer
        anderen Familie und sagt danach in der Klassenverwaltung Bescheid
        (<a href={`mailto:${klasse.contactMail}`}>{klasse.contactName || klasse.contactMail}</a>).
      </p>
    </>
  )}
</Layout>
