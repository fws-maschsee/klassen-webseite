---
import Layout from '@levino/shipyard-base/layouts/Page.astro'
import { klassenConfig } from '../../../../src/klasse/config.ts'
import { openDb } from '../../../../src/lib/db/index.ts'
import {
	listMailingLists,
	normalizeEmail,
	resolveListRecipients,
} from '../../../../src/lib/db/mailingLists.ts'
import { tokenFuer } from '../../../../src/lib/db/recipientSettings.ts'
import { sesTransport } from '../../../../src/lib/email/transport.ts'
import { buildLinkMail } from '../../../../src/lib/lists/settingsLink.ts'

export const prerender = false

/**
 * „Ich möchte meine Einstellungen ändern" — ohne Anmeldung und ohne Token in
 * der Adresse.
 *
 * Warum dieser Umweg: Der persönliche Link trägt einen Schlüssel. Stünde er im
 * Fuß jeder Rundmail, ginge er beim ersten Zitat an die ganze Klasse — und wer
 * ihn sieht, könnte fremde Leute abmelden. Im Fuß steht deshalb nur diese
 * Adresse hier; den Schlüssel bekommt man per Mail, also genau dorthin, wo man
 * ihn schon hätte haben müssen.
 *
 * Im `List-Unsubscribe`-Header steht der Schlüssel weiterhin direkt. Header
 * werden beim Antworten nicht zitiert, der Knopf im Mailprogramm führt also
 * ohne Umweg ans Ziel.
 *
 * DIE SEITE VERRÄT NICHT, WER IM VERTEILER STEHT. Die Antwort ist immer
 * dieselbe, ob die Adresse bekannt ist oder nicht — sonst wäre das Formular ein
 * Werkzeug, um genau das durchzuprobieren. Verschickt wird nur an Adressen, die
 * wirklich auf einer Liste dieser Klasse stehen; das ist zugleich die Schranke
 * dagegen, hier Fremden Post zu schicken.
 */

const { label: klasse, contactMail, contactName } = klassenConfig()

let gesendet = false
let fehler: string | null = null

if (Astro.request.method === 'POST') {
	const formular = await Astro.request.formData()
	const eingabe = String(formular.get('email') ?? '').trim()

	if (!eingabe.includes('@')) {
		fehler = 'Das sieht nicht nach einer E-Mail-Adresse aus.'
	} else {
		const adresse = normalizeEmail(eingabe)
		const db = openDb()
		const listen = listMailingLists(db).filter((liste) => liste.aktiv === 1)
		const bekannt = listen.some((liste) =>
			resolveListRecipients(liste, db).some(
				(empfaenger) => normalizeEmail(empfaenger.email) === adresse,
			),
		)

		if (bekannt) {
			try {
				await sesTransport().send(
					buildLinkMail(adresse, tokenFuer(adresse, db)),
				)
			} catch (err) {
				// Fehler protokollieren, aber der Seite nichts davon sagen: Auch das
				// wäre ein Unterschied, an dem sich ablesen ließe, ob eine Adresse
				// bekannt ist.
				console.error(
					`[einstellungen] Link an ${adresse} nicht verschickt: ${
						err instanceof Error ? err.message : String(err)
					}`,
				)
			}
		}
		gesendet = true
	}
}
---

<Layout title={`Einstellungen für die Verteiler der ${klasse}`}>
	<div class="prose max-w-2xl">
		<h1>Einstellungen für die Verteiler der {klasse}</h1>

		{
			gesendet ? (
				<>
					<p>
						Wenn diese Adresse in einem Verteiler der {klasse} steht, ist der
						persönliche Link gerade unterwegs dorthin. Er läuft nicht ab.
					</p>
					<p>
						Kommt nichts an, steht die Adresse vermutlich nicht (oder anders
						geschrieben) im Verteiler. Dann hilft eine Nachricht an{' '}
						<a href={`mailto:${contactMail}`}>{contactName ?? contactMail}</a>.
					</p>
				</>
			) : (
				<>
					<p>
						Hier lässt sich einstellen, was jede Adresse von den Verteilern der
						Klasse bekommt — bis hin zum vollständigen Abmelden.
					</p>
					<p>
						Damit das niemand für eine fremde Adresse tun kann, geht der
						persönliche Link per Mail an genau diese Adresse.
					</p>
					{fehler && <p class="text-error">{fehler}</p>}
					{/* `grid gap-1` statt `form-control`, `label` statt `label-text`, und
					    die Border ist Vorgabe statt `input-bordered`: daisyUI 5 hat die
					    drei alten Klassennamen ersatzlos gestrichen. Sie stehen zu
					    lassen kostet keinen Fehler, nur die Formatierung. */}
					<form method="POST" class="not-prose flex flex-col gap-3 max-w-md">
						<label class="grid gap-1">
							<span class="label">E-Mail-Adresse</span>
							<input
								type="email"
								name="email"
								required
								autocomplete="email"
								class="input w-full"
							/>
						</label>
						<button type="submit" class="btn btn-primary self-start">
							Link schicken
						</button>
					</form>
				</>
			)
		}
	</div>
</Layout>
