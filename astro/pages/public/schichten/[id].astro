---
import Page from '@levino/shipyard-base/layouts/Page.astro'
import Schlicht from '../../../layouts/Schlicht.astro'
import { klassenConfig } from '../../../../src/klasse/config.ts'
import {
  belegungNachBloecken,
  eintraegeLesen,
  standLesen,
  zusagenUrl,
} from '../../../../src/lib/db/schichten.ts'
import { besucherLesen } from '../../../../src/routes/besucher.ts'

export const prerender = false

const id = Astro.params.id ?? ''
const stand = standLesen(id)
if (!stand) {
  return new Response('Diesen Schichtplan gibt es nicht.', { status: 404 })
}

const { label: klasse } = klassenConfig()
const besucher = await besucherLesen(Astro.request)
const Layout = besucher.sub ? Page : Schlicht
const anmeldeLink = `/auth/login?rd=${encodeURIComponent(`/public/schichten/${id}`)}`
const parameter = new URL(Astro.request.url).searchParams
const fehler = parameter.get('fehler')
const { list } = stand
const offen = list.status === 'open'
const eigene = new Set(
  besucher.sub
    ? eintraegeLesen(list.id)
        .filter((e) => e.owner_sub === besucher.sub)
        .map((e) => e.id)
    : [],
)
const bloecke = belegungNachBloecken(stand)
const eingetragen = stand.entries.find((e) => e.id === parameter.get('eingetragen'))
const datum = list.event_date
  ? new Date(`${list.event_date}T12:00:00Z`).toLocaleDateString('de-DE', {
      weekday: 'long',
      day: 'numeric',
      month: 'long',
      year: 'numeric',
    })
  : null
const frei = (s: { capacity: number | null; count: number }) =>
  s.capacity === null
    ? s.count === 0
      ? 'noch niemand'
      : `${s.count} dabei`
    : s.count >= s.capacity
      ? 'voll'
      : `${s.capacity - s.count} von ${s.capacity} frei`
const klickbar = (s: { full: boolean }) => offen && (!s.full || besucher.admin)
const darfAbgeben = (entryId: string) => offen && (besucher.admin || eigene.has(entryId))
---

<Layout title={list.title}>
  <div class={besucher.sub ? 'container mx-auto max-w-3xl px-4 py-8' : ''}>
  {besucher.sub && <h1 class="text-2xl font-semibold">{list.title}</h1>}
  <p class="mb-6 text-sm opacity-70">Schichtplan der {klasse}{datum ? ` · ${datum}` : ''}</p>

  {eingetragen && (
    <div class="alert alert-success mb-6" role="status" data-eingetragen>
      <span>Danke, {eingetragen.name}! Du bist eingetragen für <strong>{eingetragen.shift}</strong>.</span>
    </div>
  )}
  {fehler && (
    <div class="alert alert-error mb-6" role="alert">{fehler}</div>
  )}
  {!offen && (
    <div class="alert alert-info mb-6" role="status">
      Dieser Schichtplan ist geschlossen — eintragen und ändern geht nicht mehr.
    </div>
  )}
  {!besucher.sub && offen && (
    <div class="alert mb-6" role="note">
      <span>Angemeldet ist es besser: dein Name ist dann schon eingetragen, und du kannst deine Schicht später von jedem Gerät aus abgeben.</span>
      <a class="btn btn-primary btn-sm" href={anmeldeLink}>Anmelden</a>
    </div>
  )}

  {list.description && <p class="mb-6 whitespace-pre-line">{list.description}</p>}

  <div class="mb-6 flex flex-wrap items-center justify-between gap-2">
    <p class="text-sm opacity-70">{offen ? 'Tipp auf eine freie Schicht, um sie zu übernehmen.' : ''}</p>
    <a class="btn btn-sm btn-outline" href={`/public/schichten/${list.id}/uebersicht`}>Ganzen Plan ansehen</a>
  </div>

  <div class="grid gap-6" id="schichten">
    {bloecke.map((b) => (
      <section class="card border border-base-300 bg-base-100">
        <div class="card-body gap-3 p-4 sm:p-6">
          {b.title && <h2 class="card-title text-lg">{b.title}</h2>}
          {b.description && <p class="whitespace-pre-line text-sm opacity-80">{b.description}</p>}
          <ul class="grid gap-2 sm:grid-cols-2">
            {b.shifts.map((s) => {
              const inhalt = (
                <>
                  <span class="flex items-baseline justify-between gap-2">
                    <span class="font-medium">{s.label}</span>
                    <span class={`badge badge-sm shrink-0 ${s.full ? 'badge-ghost' : s.count === 0 ? 'badge-outline' : 'badge-primary'}`}>{frei(s)}</span>
                  </span>
                  {s.entries.length > 0 && (
                    <span class="mt-1 block text-sm opacity-70">{s.entries.map((e) => e.name).join(', ')}</span>
                  )}
                </>
              )
              return (
                <li data-shift={s.key}>
                  {klickbar(s) ? (
                    <a class="block rounded-box border border-base-300 p-3 transition hover:border-primary hover:bg-base-200 focus-visible:outline-2 focus-visible:outline-primary" href={zusagenUrl(list.id, s.key)}>
                      {inhalt}
                    </a>
                  ) : (
                    <div class="block rounded-box border border-base-200 bg-base-200/50 p-3 opacity-60" aria-disabled="true">
                      {inhalt}
                    </div>
                  )}
                  {s.entries.map((e) => (
                    <div class="mt-1 flex items-center justify-end gap-2 text-xs" data-entry-id={e.id} hidden={!darfAbgeben(e.id)}>
                      <span class="opacity-70">{e.name}</span>
                      <button class="btn btn-xs btn-ghost text-error" type="button" data-loeschen={e.id} data-name={e.name} data-schicht={e.shift}>Abgeben</button>
                    </div>
                  ))}
                </li>
              )
            })}
          </ul>
        </div>
      </section>
    ))}
  </div>

  <p class="mt-8 text-xs opacity-60">
    Dieser Plan ist nur über seinen Link erreichbar und wird nach dem Anlass automatisch gelöscht.
  </p>
  </div>

  <script is:inline define:vars={{ listId: list.id, revision: list.revision, offen }}>
    (() => {
      const speicherKey = `schichten:${listId}`
      const lade = () => { try { return JSON.parse(localStorage.getItem(speicherKey) || '{}') } catch { return {} } }
      const speichere = (m) => { try { localStorage.setItem(speicherKey, JSON.stringify(m)) } catch {} }
      const meine = lade()

      if (offen) {
        for (const zeile of document.querySelectorAll('[data-entry-id]')) {
          if (meine[zeile.dataset.entryId]) zeile.hidden = false
        }
      }

      document.addEventListener('click', async (ev) => {
        const b = ev.target.closest('button[data-loeschen]')
        if (!b) return
        const entryId = b.dataset.loeschen
        if (!confirm(`Schicht von ${b.dataset.name} (${b.dataset.schicht}) abgeben?`)) return
        const r = await fetch(`/public/schichten/${listId}/eintrag`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded', Accept: 'application/json' },
          body: new URLSearchParams({ aktion: 'löschen', entry_id: entryId, edit_token: meine[entryId] || '' }),
        })
        const res = await r.json().catch(() => ({ ok: false }))
        if (!res.ok) { alert(res.fehler || 'Das hat nicht geklappt.'); return }
        delete meine[entryId]; speichere(meine)
        location.replace(`/public/schichten/${listId}`)
      })

      // Neu laden statt neu zeichnen: die Seite ist fast ganz serverseitig gebaut, so bleibt nur eine Darstellung zu pflegen.
      const pruefe = async () => {
        try {
          const r = await fetch(`/public/schichten/${listId}/stand?ab=${revision}`, { cache: 'no-store' })
          if (r.status === 200) location.reload()
        } catch {}
      }
      setInterval(pruefe, 5000)
      document.addEventListener('visibilitychange', () => { if (!document.hidden) pruefe() })
    })()
  </script>
</Layout>
