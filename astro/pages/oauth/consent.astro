---
import Layout from '@levino/shipyard-base/layouts/Page.astro'
import {
	createAuthCode,
	deletePendingAuthorization,
	getClient,
	getPendingAuthorization,
} from '../../../src/lib/db/oauth.ts'
import { instanceLabel } from '../../../src/lib/db/instance.ts'
import { canEdit } from '../../../src/server/auth/roles.ts'
import { verifyRequest } from '../../../src/server/auth/index.ts'
import { pruefeRedirectUri } from '../../../src/server/oauth/redirectZiel.ts'

export const prerender = false

const url = new URL(Astro.request.url)
const pendingId = url.searchParams.get('pending_id')

if (!pendingId) {
	return new Response('pending_id fehlt', { status: 400 })
}

const pending = getPendingAuthorization(pendingId)
if (!pending) {
	return new Response('Anfrage unbekannt oder abgelaufen', { status: 410 })
}

const client = getClient(pending.client_id)
if (!client) {
	return new Response('Unbekannter Client', { status: 410 })
}

const auth = await verifyRequest(Astro.request)
if (!auth.ok) {
	return new Response(
		auth.reason === 'unauthenticated'
			? 'Bitte zuerst auf der Website anmelden und diesen Link erneut oeffnen.'
			: 'Dieser Zugang gehoert nicht zur Klasse.',
		{ status: auth.reason === 'unauthenticated' ? 401 : 403 },
	)
}

const userId = auth.user.id

const redirect = pruefeRedirectUri(pending.redirect_uri)
if (!redirect.ok) {
	return new Response('Unzulässiges Rücksprungziel', { status: 400 })
}
const ziel = redirect.ziel

if (Astro.request.method === 'POST') {
	const form = await Astro.request.formData()
	const action = form.get('action')
	const redirectUrl = new URL(pending.redirect_uri)
	if (pending.state) {
		redirectUrl.searchParams.set('state', pending.state)
	}
	deletePendingAuthorization(pendingId)
	if (action === 'approve') {
		const code = createAuthCode({
			client_id: pending.client_id,
			user_id: userId,
			// MCP-Clients haben kein Sitzungs-Cookie; die Rollen müssen über Code und Token mitreisen.
			roles: auth.user.roles,
			code_challenge: pending.code_challenge,
			code_challenge_method: pending.code_challenge_method,
			redirect_uri: pending.redirect_uri,
			scopes: pending.scopes ?? undefined,
			resource: pending.resource ?? undefined,
		})
		redirectUrl.searchParams.set('code', code)
	} else {
		redirectUrl.searchParams.set('error', 'access_denied')
		redirectUrl.searchParams.set(
			'error_description',
			'Die Anfrage wurde abgelehnt.',
		)
	}
	return Astro.redirect(redirectUrl.toString())
}

const scopeList = pending.scopes ?? ['mcp']

const mayEdit = canEdit(auth.user.roles)

---

<Layout title="Anwendung autorisieren">
  <div class="container mx-auto px-4 py-12 max-w-xl">
    <h1 class="text-2xl font-bold mb-4">Anwendung autorisieren</h1>
    <p class="mb-6">
      Eine Anwendung möchte auf die Mitglieder- und Verteilerverwaltung der
      Instanz <strong>{instanceLabel()}</strong> zugreifen.
    </p>

    <div class="not-prose bg-base-100 shadow-sm rounded-lg p-4 mb-6">
      <p class="text-sm opacity-70 mb-1">Der Zugang geht an:</p>
      <p class="text-xl font-bold font-mono break-all" data-redirect-host>{ziel.host}</p>
      <p class="text-sm mt-1">
        {ziel.art === 'lokal'
          ? 'Ein Programm auf diesem Gerät (zum Beispiel Claude Code). Nur zustimmen, wenn Du es gerade selbst gestartet hast.'
          : 'Claude von Anthropic (Connector in claude.ai oder der Claude-App).'}
      </p>

      <p class="text-sm opacity-70 mt-4 mb-1">
        Name, den die Anwendung selbst angibt (nicht geprüft):
      </p>
      <p class="font-mono text-sm break-all" data-client-name>{client.client_name}</p>

      <p class="text-sm opacity-70 mt-4 mb-1">Berechtigungen:</p>
      <ul class="text-sm list-disc list-inside">
        {scopeList.map((s) => (
          <li class="font-mono">{s}</li>
        ))}
      </ul>
    </div>

    <div role="alert" class="alert alert-warning mb-6">
      <span>
        Nur zustimmen, wenn Du diese Verbindung gerade selbst eingerichtet hast.
        Hat Dir jemand diesen Link geschickt, lehne ab.
      </span>
    </div>

    <p class="text-sm opacity-70 mb-6">
      Angemeldet als <strong>{auth.user.email}</strong>. Die Verbindung gibt
      Zugriff auf Namen und E-Mail-Adressen der Eltern dieser Klasse.
    </p>

    <p class="text-sm opacity-70 mb-6">
      {mayEdit
        ? 'Dieser Zugang hat die Rolle "admin": die Verbindung darf Mitglieder, Gruppen und Listen aendern und an Listen senden.'
        : 'Dieser Zugang hat nur die Rolle "mitglied": die Verbindung darf lesen, aber nichts aendern und nicht senden.'}
    </p>

    <form method="POST" class="flex gap-3">
      <button type="submit" name="action" value="approve" class="btn btn-primary flex-1">
        Autorisieren
      </button>
      <button type="submit" name="action" value="deny" class="btn btn-ghost flex-1">
        Ablehnen
      </button>
    </form>
  </div>
</Layout>
