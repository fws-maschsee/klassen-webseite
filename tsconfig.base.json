{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"types": ["node"],
		"strict": true,
		"noImplicitOverride": true,
		"noFallthroughCasesInSwitch": true,
		"verbatimModuleSyntax": true,
		"isolatedModules": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"paths": {
			"@levino/shipyard-base": ["./astro/types/shipyard-base.d.ts"],
			"@levino/shipyard-blog": ["./astro/types/shipyard-blog.d.ts"],
			"@levino/shipyard-docs": ["./astro/types/shipyard-docs.d.ts"]
		},
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"erasableSyntaxOnly": true
	}
}
