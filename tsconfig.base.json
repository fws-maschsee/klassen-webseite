{
	"compilerOptions": {
		"target": "ES2022",
		// DOM wegen Request/Response/Headers, nicht für einen Browser.
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"types": ["node"],
		"strict": true,
		"noImplicitOverride": true,
		"noFallthroughCasesInSwitch": true,
		"verbatimModuleSyntax": true,
		"isolatedModules": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		// Stubs, weil tsc shipyards rohes TS an endungslosen Importen scheitern lässt (TS2835).
		"paths": {
			"@levino/shipyard-base": ["./astro/types/shipyard-base.d.ts"],
			"@levino/shipyard-blog": ["./astro/types/shipyard-blog.d.ts"],
			"@levino/shipyard-docs": ["./astro/types/shipyard-docs.d.ts"]
		},
		"allowImportingTsExtensions": true,
		"noEmit": true,
		// Node strippt nur Typen: enum, Parameter-Properties usw. schlügen erst zur Laufzeit fehl.
		"erasableSyntaxOnly": true
	}
}
