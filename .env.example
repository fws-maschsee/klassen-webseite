# Vorlage für die Umgebungsvariablen, die der geteilte Code liest.
#
# Sie steht hier und nicht (nur) in den Klassen-Repos, weil der Code, der sie
# liest, hier liegt: wer eine Variable hinzufügt, pflegt die Erklärung im selben
# Commit. `<klasse>` ist überall der Slug aus der `KlassenConfig`.
#
# Fast alle Werte haben eine Vorgabe aus der `KlassenConfig` und müssen nur
# gesetzt werden, wenn sie davon abweichen. Ohne Vorgabe sind: die Zugangsdaten.

# ---------------------------------------------------------------------------
# Instanz-Identität — EIN Deployment PRO KLASSE
# ---------------------------------------------------------------------------
# Muss zu dem Namen passen, der in der SQLite-Datei hinterlegt ist
# (app_meta.instance). Passt beides nicht zusammen, startet der Server gar
# nicht — das ist Absicht: sonst geht der nächste Versand an die falsche Klasse.
# Ohne Wert gilt `slug` aus der KlassenConfig.
MCP_INSTANCE_NAME=<klasse>
# Ohne Wert gilt `label` aus der KlassenConfig.
MCP_INSTANCE_LABEL=

# ---------------------------------------------------------------------------
# Datenbank
# ---------------------------------------------------------------------------
# DB_PATH liest die Anwendung, DATABASE_URL liest dbmate. Beide müssen auf
# dieselbe Datei zeigen. Ohne DB_PATH gilt `dbPath` aus der KlassenConfig
# (`./data/<klasse>.db`). Im Container: /data/<klasse>.db
DB_PATH=./data/<klasse>.db
DATABASE_URL=sqlite:./data/<klasse>.db

# ---------------------------------------------------------------------------
# Öffentliche Adresse (OAuth-Issuer für den MCP-Endpunkt)
# ---------------------------------------------------------------------------
# Muss exakt der Adresse entsprechen, unter der die Instanz erreichbar ist —
# sonst lehnt der MCP-Client die Tokens ab. Ohne Wert gilt `siteUrl`.
PUBLIC_BASE_URL=http://localhost:4321
PORT=4321

# ---------------------------------------------------------------------------
# Versand über Amazon SES (SMTP-Interface)
# ---------------------------------------------------------------------------
# PORT 2587 IST ABSICHT und darf nicht "vereinheitlicht" werden: 25, 465 und
# 587 waren zwischenzeitlich providerseitig blockiert, 2587 funktioniert
# unabhängig davon.
SES_SMTP_HOST=email-smtp.eu-central-1.amazonaws.com
SES_SMTP_PORT=2587
# SES-SMTP-Credentials, NICHT die IAM-Access-Keys.
SES_SMTP_USER=
SES_SMTP_PASSWORD=

# Verifizierte Absenderadresse. Ohne Wert gilt `mailFrom` aus der KlassenConfig.
MAIL_FROM=
# Absendername. Ohne Wert gilt `label`.
MAIL_FROM_NAME=
# Antwortadresse für Rundmails. Ohne Wert wird MAIL_FROM genommen.
MAIL_REPLY_TO=

# Drosselung: maximal so viele Mails pro Stunde über beide Warteschlangen
# zusammen (Rundmails + Mailinglisten).
MAIL_HOURLY_CAP=250
MAIL_PARALLEL_BURST=25

# ---------------------------------------------------------------------------
# Mailinglisten
# ---------------------------------------------------------------------------
# Vollständige Listen-Domain INKLUSIVE Klassen-Label. Eine Liste `eltern` ist
# damit eltern@<klasse>.lists.fws-maschsee-test.de — genau die Adresse, für die
# der Worker das Routing hat (dort heißt die Variable LIST_DOMAIN und enthält
# nur `lists.fws-maschsee-test.de`, das Klassen-Label kommt aus CLASS_SLUG).
# Ohne Wert leitet die App sie aus MCP_INSTANCE_NAME bzw. `listDomain` ab.
LIST_DOMAIN=

# Envelope-Absender (Return-Path) der weiterverteilten Mails. Ohne Wert:
# MAIL_FROM.
LIST_ENVELOPE_FROM=

# Hier stand LIST_MEMBER_GROUP — die Group, in die aus ZITADEL gespiegelte
# Personen wanderten. Es gibt keine Spiegelung mehr: Adressbuch und ZITADEL sind
# getrennte Datenschichten, wer im Verteiler steht, wird von Hand eingetragen
# (siehe README, „ZITADEL und das Adressbuch sind getrennte Datenschichten").
# Ein noch gesetzter Wert wird von der App ignoriert.

# Sicherheitsventil für die Erprobung: Ist der Wert gesetzt, bekommt NUR Post,
# wessen Adresse darin steht (kommagetrennt; ein führendes `@domain` erlaubt
# eine ganze Domain). Leer lassen heißt Echtbetrieb.
LIST_RECIPIENT_ALLOWLIST=

# „Ohne Konto, keine E-Mail" — die Prüfung vor JEDEM Versand (Verteiler,
# Rundmail, Putz-Erinnerung). Sie vergleicht die Empfänger mit den Konten, die
# im ZITADEL-Projekt dieser Klasse einen aktiven Grant mit Leserolle haben.
# Verbunden wird über `mitglieder.user_sub`, und wo der (noch) fehlt, über die
# normalisierte E-Mail-Adresse. Details: `src/lib/versand/kontopruefung.ts`.
#
#   report   (Vorgabe) Es wird NICHTS geschnitten. Die Prüfung läuft trotzdem
#            und protokolliert, wen sie treffen würde und warum — und in die
#            andere Richtung, welche Konten mit Rolle KEINEN Adressbuch-Eintrag
#            haben und deshalb nichts bekommen.
#   enforce  Es wird geschnitten, und dieselbe Meldung geht heraus.
#
# WARUM DIE VORGABE `report` IST: Damit die Umstellung jemand bewusst macht,
# nachdem er den Bericht einmal gesehen hat. Nachgemessen am 15.08. deckten sich
# Adressbuch und Grants in `klasse-wiesen` exakt und in `klasse-christophers`
# bis auf drei Fälle — `enforce` wäre dort also harmlos. In einer dritten Klasse
# weiß das niemand vorher, und eine Voreinstellung, die beim ersten Einsatz
# still den halben Verteiler abschneidet, wäre die falsche.
#
# Der Bericht dieser Prüfung erreicht nur dann jemanden per Mail, wenn er etwas
# zu melden hat — jemand wurde übergangen, oder jemandem fehlt der
# Adressbuch-Eintrag. Bei sauberer Lage steht er nur im Protokoll und am
# Rückgabewert. Die Putz-Erinnerung läuft jeden Sonntag; eine wöchentliche Mail
# mit lauter Nullen lernt man wegzuklicken, und danach klickt man die weg, in
# der etwas steht.
#
# ACHTUNG bei `enforce`: Ist ZITADEL nicht erreichbar, wird NICHT verschickt.
# Eine Listenmail beantwortet die App dann mit 503 (der Dispatcher stellt später
# erneut zu), eine Rundmail bricht mit einem Fehler ab, und die Putz-Erinnerung
# gibt den Termin zurück und versucht es später erneut. Lieber keine Mail als
# eine an Leute, die nicht mehr dazugehören.
LIST_ACCOUNT_CHECK=report

# Geteiltes Geheimnis zwischen dem ALTEN Cloudflare-Email-Worker DIESER Klasse
# und dieser App (HMAC-SHA256). Muss auf beiden Seiten identisch sein (im Worker
# als Secret via `wrangler secret put`).
#
# Nur noch fuer die alten Worker je Klasse. Der neue zonenweite Dispatcher
# signiert mit Ed25519 und schickt `X-List-Key-Id` mit; geprueft wird dann gegen
# `listPublicKeyPem` aus der KlassenConfig, und dieser Wert wird nicht gebraucht.
# Solange eine Liste noch eine literale Email-Routing-Regel hat, laeuft sie
# weiter ueber den alten Worker — bis dahin muss dieser Wert stehen. Fehlt er,
# weist die App jede Listenmail OHNE `X-List-Key-Id` mit 401 ab (und nicht
# stillschweigend keine Pruefung).
LIST_WEBHOOK_SECRET=

# Eigenes Größenlimit für eingehende Listenmail (Bytes). Zweite
# Verteidigungslinie hinter MAX_MESSAGE_BYTES im Worker. Default 10 MiB.
MAX_MESSAGE_BYTES=10485760

# ---------------------------------------------------------------------------
# Putzplan-Erinnerung
# ---------------------------------------------------------------------------
# QUITTUNG: Adresse, die nach jeder tatsächlich verschickten Erinnerung eine
# kurze Bestätigung bekommt („Klasse Wiesen: Erinnerung raus an … (21.08.)") —
# welche Klasse, welcher Termin, welche Familien, an wie viele Adressen, und was
# schiefging.
#
# Sie ist das Gegenteil der Meldung daneben: Die kommt, wenn etwas schiefging,
# die Quittung kommt, WEIL nichts schiefging. Sie ist ausdrücklich VORLÄUFIG —
# sie soll zeigen, dass der Dienst überhaupt läuft, solange ihm noch niemand
# traut. Genau deshalb steht sie hier und nicht im Code: **Leeren oder
# weglassen schaltet sie ab**, ohne dass jemand einen Pull Request braucht.
#
# Sie geht NUR nach einem echten Versand raus — nicht bei „noch nicht fällig",
# nicht bei „hat schon ein anderer Tick gemacht", nicht ohne anstehenden Termin.
# Sonst käme sie alle paar Minuten, und dann wäre sie Lärm statt Auskunft.
REMINDER_RECEIPT_TO=

# ---------------------------------------------------------------------------
# Anmeldung (ZITADEL)
# ---------------------------------------------------------------------------
# Ohne Wert: https://id.fws-maschsee-test.de
OIDC_ISSUER=
# Der OIDC-Client des ZITADEL-Projekts DIESER Klasse. Genau daraus entsteht die
# Trennung der Klassen: das Token enthält nur die Rollen dieses Projekts.
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Projektrolle, die Zugang gewährt. Ohne Wert gilt `authRole` (`mitglied`).
OIDC_REQUIRED_ROLE=
# Schlüssel für das verschlüsselte Sitzungs-Cookie. Beliebig lang; der Code
# bildet daraus per SHA-256 die 32 Byte, die A256GCM verlangt.
SESSION_SECRET=

# Nur für Tests: schaltet die Anmeldung vollständig ab.
DISABLE_AUTH=

# Zugang zur Management-API von ZITADEL. Daraus kommt die Antwort auf „was darf
# diese Person" (`src/server/auth/grants.ts`) — und damit auch die Konten-Prüfung
# vor dem Versand und der Abgleich (`reconcile_accounts`).
#
# Ohne diese drei verweigert die App JEDE Rechteprüfung, statt durchzuwinken:
# Wer nicht weiß, wer jemand ist, lässt ihn nicht herein.
ZITADEL_ORG_ID=
ZITADEL_PROJECT_ID=
# Token eines Maschinen-Benutzers mit Leserecht auf Grants und Benutzer der
# Organisation dieser Klasse.
ZITADEL_SERVICE_TOKEN=

# Hier stand bis zum 15.08. ein `ZITADEL_WEBHOOK_SIGNING_KEY`: das geteilte
# Geheimnis mit einem ZITADEL-Target, das `user.removed` an die App schicken
# sollte. Das Target ist in der Instanz nie angelegt worden, der Endpunkt hat
# nie einen Aufruf gesehen — beides ist entfernt. An seine Stelle tritt der
# Abgleich, und der fragt mit dem Token von oben nach, statt auf einen Ruf zu
# warten; ein zweites Geheimnis braucht er nicht.

# ---------------------------------------------------------------------------
# Vorschau-Umgebungen (PR-Previews)
# ---------------------------------------------------------------------------
# `true` befüllt die Datenbank beim Start mit ERFUNDENEN Familien, einem
# Putzplan und zwei Verteilern (`src/lib/db/saatdaten.ts`). Gedacht für die
# Vorschau-Umgebung eines Pull Requests, die einen eigenen, leeren Datenträger
# (`emptyDir`) hat und nie eine Kopie der Produktionsdatenbank bekommt.
#
# In der Produktion tut der Schalter NICHTS, und das ist keine Absichtserklärung,
# sondern eine Sicherung: Gesät wird nur in eine Datenbank, die genau so
# aussieht wie eine frisch migrierte. Die Produktionsdatei ist das nicht — dort
# steht in `app_meta` die Instanz-Identität und in `mitglieder` stehen die
# Familien. Geprüft von `tests/db/saatdaten.test.ts`.
SEED_DEMO_DATA=
