# Vorlage für die Umgebungsvariablen, die der geteilte Code liest.
#
# Sie steht hier und nicht (nur) in den Klassen-Repos, weil der Code, der sie
# liest, hier liegt: wer eine Variable hinzufügt, pflegt die Erklärung im selben
# Commit. `<klasse>` ist überall der Slug aus der `KlassenConfig`.
#
# Fast alle Werte haben eine Vorgabe aus der `KlassenConfig` und müssen nur
# gesetzt werden, wenn sie davon abweichen. Ohne Vorgabe sind: die Zugangsdaten.

# ---------------------------------------------------------------------------
# Instanz-Identität — EIN Deployment PRO KLASSE
# ---------------------------------------------------------------------------
# Muss zu dem Namen passen, der in der SQLite-Datei hinterlegt ist
# (app_meta.instance). Passt beides nicht zusammen, startet der Server gar
# nicht — das ist Absicht: sonst geht der nächste Versand an die falsche Klasse.
# Ohne Wert gilt `slug` aus der KlassenConfig.
MCP_INSTANCE_NAME=<klasse>
# Ohne Wert gilt `label` aus der KlassenConfig.
MCP_INSTANCE_LABEL=

# ---------------------------------------------------------------------------
# Datenbank
# ---------------------------------------------------------------------------
# DB_PATH liest die Anwendung, DATABASE_URL liest dbmate. Beide müssen auf
# dieselbe Datei zeigen. Ohne DB_PATH gilt `dbPath` aus der KlassenConfig
# (`./data/<klasse>.db`). Im Container: /data/<klasse>.db
DB_PATH=./data/<klasse>.db
DATABASE_URL=sqlite:./data/<klasse>.db

# ---------------------------------------------------------------------------
# Öffentliche Adresse (OAuth-Issuer für den MCP-Endpunkt)
# ---------------------------------------------------------------------------
# Muss exakt der Adresse entsprechen, unter der die Instanz erreichbar ist —
# sonst lehnt der MCP-Client die Tokens ab. Ohne Wert gilt `siteUrl`.
PUBLIC_BASE_URL=http://localhost:4321
PORT=4321

# ---------------------------------------------------------------------------
# Versand über Amazon SES (SMTP-Interface)
# ---------------------------------------------------------------------------
# PORT 2587 IST ABSICHT und darf nicht "vereinheitlicht" werden: 25, 465 und
# 587 waren zwischenzeitlich providerseitig blockiert, 2587 funktioniert
# unabhängig davon.
SES_SMTP_HOST=email-smtp.eu-central-1.amazonaws.com
SES_SMTP_PORT=2587
# SES-SMTP-Credentials, NICHT die IAM-Access-Keys.
SES_SMTP_USER=
SES_SMTP_PASSWORD=

# Verifizierte Absenderadresse. Ohne Wert gilt `mailFrom` aus der KlassenConfig.
MAIL_FROM=
# Absendername. Ohne Wert gilt `label`.
MAIL_FROM_NAME=
# Antwortadresse für Rundmails. Ohne Wert wird MAIL_FROM genommen.
MAIL_REPLY_TO=

# Drosselung: maximal so viele Mails pro Stunde über beide Warteschlangen
# zusammen (Rundmails + Mailinglisten).
MAIL_HOURLY_CAP=250
MAIL_PARALLEL_BURST=25

# ---------------------------------------------------------------------------
# Mailinglisten
# ---------------------------------------------------------------------------
# Vollständige Listen-Domain INKLUSIVE Klassen-Label. Eine Liste `eltern` ist
# damit eltern@<klasse>.lists.fws-maschsee-test.de — genau die Adresse, für die
# der Worker das Routing hat (dort heißt die Variable LIST_DOMAIN und enthält
# nur `lists.fws-maschsee-test.de`, das Klassen-Label kommt aus CLASS_SLUG).
# Ohne Wert leitet die App sie aus MCP_INSTANCE_NAME bzw. `listDomain` ab.
LIST_DOMAIN=

# Envelope-Absender (Return-Path) der weiterverteilten Mails. Ohne Wert:
# MAIL_FROM.
LIST_ENVELOPE_FROM=

# Hier stand LIST_MEMBER_GROUP — die Group, in die aus ZITADEL gespiegelte
# Personen wanderten. Es gibt keine Spiegelung mehr: Adressbuch und ZITADEL sind
# getrennte Datenschichten, wer im Verteiler steht, wird von Hand eingetragen
# (siehe README, „ZITADEL und das Adressbuch sind getrennte Datenschichten").
# Ein noch gesetzter Wert wird von der App ignoriert.

# Sicherheitsventil für die Erprobung: Ist der Wert gesetzt, bekommt NUR Post,
# wessen Adresse darin steht (kommagetrennt; ein führendes `@domain` erlaubt
# eine ganze Domain). Leer lassen heißt Echtbetrieb.
LIST_RECIPIENT_ALLOWLIST=

# Geteiltes Geheimnis zwischen dem ALTEN Cloudflare-Email-Worker DIESER Klasse
# und dieser App (HMAC-SHA256). Muss auf beiden Seiten identisch sein (im Worker
# als Secret via `wrangler secret put`).
#
# Nur noch fuer die alten Worker je Klasse. Der neue zonenweite Dispatcher
# signiert mit Ed25519 und schickt `X-List-Key-Id` mit; geprueft wird dann gegen
# `listPublicKeyPem` aus der KlassenConfig, und dieser Wert wird nicht gebraucht.
# Solange eine Liste noch eine literale Email-Routing-Regel hat, laeuft sie
# weiter ueber den alten Worker — bis dahin muss dieser Wert stehen. Fehlt er,
# weist die App jede Listenmail OHNE `X-List-Key-Id` mit 401 ab (und nicht
# stillschweigend keine Pruefung).
LIST_WEBHOOK_SECRET=

# Eigenes Größenlimit für eingehende Listenmail (Bytes). Zweite
# Verteidigungslinie hinter MAX_MESSAGE_BYTES im Worker. Default 10 MiB.
MAX_MESSAGE_BYTES=10485760

# ---------------------------------------------------------------------------
# Anmeldung (ZITADEL)
# ---------------------------------------------------------------------------
# Ohne Wert: https://id.fws-maschsee-test.de
OIDC_ISSUER=
# Der OIDC-Client des ZITADEL-Projekts DIESER Klasse. Genau daraus entsteht die
# Trennung der Klassen: das Token enthält nur die Rollen dieses Projekts.
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Projektrolle, die Zugang gewährt. Ohne Wert gilt `authRole` (`mitglied`).
OIDC_REQUIRED_ROLE=
# Schlüssel für das verschlüsselte Sitzungs-Cookie. Beliebig lang; der Code
# bildet daraus per SHA-256 die 32 Byte, die A256GCM verlangt.
SESSION_SECRET=

# Nur für Tests: schaltet die Anmeldung vollständig ab.
DISABLE_AUTH=

# Geteiltes Geheimnis mit dem ZITADEL-Target, das `user.removed` an
# POST /api/zitadel/events schickt (HMAC-SHA256, Header `ZITADEL-Signature`).
#
# Der Wert entsteht EINMALIG beim Anlegen des Targets in
# fws-maschsee/server-config (`tofu/zitadel/`, siehe README) und ist danach
# nicht mehr abrufbar — er muss aus dem Tofu-State hierher.
#
# Fehlt er, weist die App JEDEN Aufruf mit 503 ab (und prüft nicht etwa nicht):
# Ohne Schlüssel kann kein Aufruf echt sein, und ein 503 heißt für ZITADEL
# „später erneut versuchen" statt „erledigt". Der Endpunkt ist öffentlich
# erreichbar; ohne Prüfung könnte jeder Adressbucheinträge löschen.
ZITADEL_WEBHOOK_SIGNING_KEY=
