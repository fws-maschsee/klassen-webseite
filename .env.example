# Muss zu app_meta.instance in der DB passen, sonst startet der Server bewusst nicht.
MCP_INSTANCE_NAME=<klasse>
MCP_INSTANCE_LABEL=

# DB_PATH liest die App, DATABASE_URL liest dbmate: beide auf dieselbe Datei.
DB_PATH=./data/<klasse>.db
DATABASE_URL=sqlite:./data/<klasse>.db

PUBLIC_BASE_URL=http://localhost:4321
PORT=4321

SES_SMTP_HOST=email-smtp.eu-central-1.amazonaws.com
# 2587 ist Absicht: 25, 465 und 587 waren providerseitig zeitweise blockiert.
SES_SMTP_PORT=2587
# SES-SMTP-Credentials, nicht die IAM-Access-Keys.
SES_SMTP_USER=
SES_SMTP_PASSWORD=

MAIL_FROM=
MAIL_FROM_NAME=
MAIL_REPLY_TO=

MAIL_HOURLY_CAP=250
MAIL_PARALLEL_BURST=25

LIST_DOMAIN=

LIST_ENVELOPE_FROM=

LIST_RECIPIENT_ALLOWLIST=

# Vorgabe report statt enforce: Umschalten soll jemand bewusst tun, nachdem er den Bericht gesehen hat.
LIST_ACCOUNT_CHECK=report

# Nur noch für die alten Worker je Klasse; der zonenweite Dispatcher signiert mit Ed25519.
LIST_WEBHOOK_SECRET=

# Zweite Verteidigungslinie hinter dem gleichnamigen Limit im Worker.
MAX_MESSAGE_BYTES=10485760

REMINDER_RECEIPT_TO=

OIDC_ISSUER=
OIDC_CLIENT_ID=
# JSON-Key der ZITADEL-App (private_key_jwt), einzeilig.
OIDC_CLIENT_KEY=
# Nur Übergang, solange OIDC_CLIENT_KEY fehlt.
OIDC_CLIENT_SECRET=
OIDC_REQUIRED_ROLE=
SESSION_SECRET=

DISABLE_AUTH=

ZITADEL_ORG_ID=
ZITADEL_PROJECT_ID=
# JSON-Key des Dienstkontos (JWT-Profile), nur für Kontolisten; leer lassen ist erlaubt.
ZITADEL_SERVICE_KEY=
# Nur Übergang, solange ZITADEL_SERVICE_KEY fehlt.
ZITADEL_SERVICE_TOKEN=
# Ohne Schlüssel antwortet /auth/zitadel-events mit 404.
ZITADEL_WEBHOOK_SIGNING_KEY=

# Wirkt nur auf eine frisch migrierte, leere DB; in der Produktion ist der Schalter wirkungslos.
SEED_DEMO_DATA=
