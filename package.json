{
	"name": "@fws-maschsee/klassen-webseite",
	"version": "0.0.0",
	"description": "Geteilter Code der Klassen-Webseiten der Freien Waldorfschule Hannover-Maschsee: Astro-Integration, Anmeldung, Mailinglisten, MCP-Server, Datenbankschema. Wird als git submodule eingebunden, nicht als npm-Package.",
	"license": "UNLICENSED",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22.12"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/fws-maschsee/klassen-webseite.git"
	},
	"scripts": {
		"typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.astro.json",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:integration": "vitest run --config vitest.integration.config.ts",
		"check": "biome check .",
		"lint:fix": "biome check --write ."
	},
	"dependencies": {
		"@astrojs/markdown-remark": "7.3.1",
		"@astrojs/node": "11.1.5",
		"@levino/shipyard-base": "0.9.2",
		"@levino/shipyard-blog": "0.9.2",
		"@levino/shipyard-docs": "0.9.2",
		"@modelcontextprotocol/sdk": "^1.30.0",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "4.3.3",
		"astro": "7.3.2",
		"better-sqlite3": "^13.0.3",
		"daisyui": "5.7.36",
		"express": "^5.2.1",
		"jose": "^6.2.12",
		"mailparser": "^3.9.24",
		"mjml": "^5.4.1",
		"nodemailer": "^9.1.1",
		"tailwindcss": "4.3.3",
		"unist-util-visit": "^5.0.0",
		"zod": "^4.6.2"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.13",
		"@tailwindcss/cli": "4.3.3",
		"@types/better-sqlite3": "^9.6.0",
		"@types/express": "^5.0.6",
		"@types/mailparser": "^3.4.6",
		"@types/mjml": "^5.0.0",
		"@types/node": "^26.5.1",
		"@types/nodemailer": "^8.0.1",
		"remark-parse": "^11.0.0",
		"typescript": "^7.0.2",
		"unified": "^11.0.5",
		"vitest": "^5.0.0"
	}
}
