{
	"name": "@fws-maschsee/klassen-webseite",
	"version": "0.0.0",
	"description": "Geteilter Code der Klassen-Webseiten der Freien Waldorfschule Hannover-Maschsee: Astro-Integration, Anmeldung, Mailinglisten, MCP-Server, Datenbankschema. Wird als git submodule eingebunden, nicht als npm-Package.",
	"license": "UNLICENSED",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22.6"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/fws-maschsee/klassen-webseite.git"
	},
	"scripts": {
		"typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.astro.json",
		"test": "vitest run",
		"test:watch": "vitest",
		"check": "biome check .",
		"lint:fix": "biome check --write ."
	},
	"dependencies": {
		"@astrojs/node": "^9.0.0",
		"@astrojs/tailwind": "^6.0.2",
		"@levino/shipyard-base": "^0.6.1",
		"@levino/shipyard-blog": "0.6.1",
		"@levino/shipyard-docs": "0.6.2",
		"@modelcontextprotocol/sdk": "^1.30.0",
		"@tailwindcss/typography": "^0.5.15",
		"astro": "^5.16.0",
		"better-sqlite3": "^12.11.1",
		"daisyui": "^4.12.0",
		"express": "^5.2.1",
		"jose": "^6.2.8",
		"mailparser": "^3.9.14",
		"mjml": "^4.18.0",
		"nodemailer": "^9.0.4",
		"tailwindcss": "^3.4.0",
		"unist-util-visit": "^5.0.0",
		"zod": "^3.25.76"
	},
	"devDependencies": {
		"@biomejs/biome": "2.2.4",
		"@types/better-sqlite3": "^9.6.0",
		"@types/express": "^5.0.6",
		"@types/mailparser": "^3.4.6",
		"@types/mjml": "^5.0.0",
		"@types/node": "^22.20.1",
		"@types/nodemailer": "^8.0.1",
		"typescript": "^5.8.2",
		"vitest": "^4.1.10"
	}
}
