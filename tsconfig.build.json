{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"noEmit": false,
		"outDir": "dist",
		"rootDir": "src",
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true
	},
	// Nur `src/` wird kompiliert. `astro/` bleibt Quelle: `.astro`-Dateien kann
	// tsc nicht, und die Integration MUSS als TypeScript ausgeliefert werden,
	// damit vite-node sie inlined (Begruendung in astro/integration.ts).
	"include": ["src"],
	"exclude": ["dist", "node_modules", "tests", "astro"]
}
